{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": { "~/*": ["src/*"] },
    "types": ["chrome", "node", "vitest/globals"]
  },
  "include": ["**/*.ts", "**/*.tsx", ".plasmo/index.d.ts"],
  "exclude": ["node_modules", "build"]
}
